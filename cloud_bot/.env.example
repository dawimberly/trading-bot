# Cloud bot — copy to cloud_bot/.env on VPS (never commit .env)

# --- Trading mode ---
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false
CLOUD_BOT_DRY_RUN=true          # false to start 24/7 loop
CLOUD_BOT_PROFILE=paper_aggressive
CLOUD_BOT_CYCLE_SEC=45
CLOUD_BOT_RESTART_SEC=30
CLOUD_BOT_MAX_RESTARTS=20
DB_MATRIX_CACHE_SEC=120

# --- Alpaca paper keys (cloud-dedicated recommended) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Legacy: ALPACA_API_KEY=  ALPACA_SECRET_KEY=

# --- Best paper stack v2.1 (defaults ON via config/profile.py) ---
# PAPER_DYNAMIC_VTI=true
# PAPER_DYNAMIC_RISK_ENABLED=true
# PAPER_STAT_ARB_ENABLED=true
# PAPER_VOL_TRADING_ENABLED=true
# PAPER_OPTIONS_SLEEVE_ENABLED=true
# PAPER_DYNAMIC_UNIVERSE=true
# PAPER_NYSE_OVERLAP_FILTER_ENABLED=true
# PAPER_ADAPTIVE_CHUNK_ENABLED=true
# PAPER_COFIRE_BUDGET_ENABLED=true

# --- Thinking engine (opt-in; requires Ollama on VPS if enabled) ---
# PAPER_THINKING_ENGINE_ENABLED=false
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Safety (circuit breaker inherited from parent config) ---
# DAILY_LOSS_CIRCUIT_BREAKER_ENABLED=true

# --- Locked OFF on cloud (do not enable) ---
# PAPER_MACRO_REGIME_ADAPTOR_ENABLED=false
# PAPER_SPY_EXIT_ON_MA_BREAK=false
# PAPER_SOCIAL_SLEEVE_ENABLED=false

# --- Observability (optional) ---
# HEARTBEAT_FILE=cloud_bot/data/cloud_bot_heartbeat.json
# PAPER_JOURNAL_CSV=cloud_bot/data/cloud_bot_journal.csv
# SENTRY_DSN=