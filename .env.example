# =============================================================================
# PythonTrading monorepo — environment pointer
# =============================================================================
# The stock bot reads .env via python-dotenv (stock-bot/config.py).
#
# Recommended setup:
#   cd stock-bot
#   copy .env.example .env
#   notepad .env
#
# Full reference (all keys, Profile A/B, Kraken, alerts, thinking engine):
#   stock-bot/.env.example
# =============================================================================

# Optional: load a specific env file from anywhere on disk
# PYTHONTRADING_ENV_FILE=stock-bot/.env

# --- Minimal live Profile A (copy these into stock-bot/.env) ---
# APCA_API_KEY_ID=your_live_key_id
# APCA_API_SECRET_KEY=your_live_secret_key
# PAPER_TRADING=false
# ALLOW_LIVE_TRADING=yes

# --- Minimal paper setup ---
# APCA_API_KEY_ID=your_paper_key_id
# APCA_API_SECRET_KEY=your_paper_secret_key
# PAPER_TRADING=true
