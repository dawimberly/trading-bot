# Alpaca paper trading (use keys from the PAPER dashboard only)
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
# PAPER_TRADING=true
# ALLOW_LIVE_TRADING=   # leave unset during paper month

# Optional: dedicated Alpaca paper account for run_spy.py only (second signup)
# If unset, SPY bot uses APCA_* above (same account as run_all.py)
# SPY_APCA_API_KEY_ID=
# SPY_APCA_API_SECRET_KEY=

# Legacy names still supported by config.get_alpaca_credentials():
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Sentiment for RHYME regimes (default: price — free, matches backtests)
# SENTIMENT_SOURCE=price

# Wisdom layer: web headlines + price math
# WISDOM_MODE=arbitrage          # default; also: baseline, web_regime, wisdom_pause, governor
# governor = pause entries when |headline-price gap| + macro stress (needs GAME_PLAN_ENABLED)
# WISDOM_MODE=governor
# GAME_PLAN_ENABLED=true
# WISDOM_GAP_THRESHOLD=0.25
# WEB_SENTIMENT_CACHE_HOURS=24
# SPACEX_IPO_MONITOR_ENABLED=true
# SPACEX_IPO_CACHE_HOURS=6
# SPACEX_IPO_ALERT_HEADLINES=3
# SPACEX_IPO_CRYPTO_OVERRIDE=true
# SPACEX_CRYPTO_OVERRIDE_MIN_BTC_HEADLINES=3
# SPACEX_CRYPTO_OVERRIDE_MIN_SPCX_PERP=1
# SPACEX_CRYPTO_OVERRIDE_MIN_SENTIMENT=-0.35
# Real IPO listing (Nasdaq SPCX — not the Hyperliquid perp)
# SPACEX_IPO_LISTING_MONITOR_ENABLED=true
# SPACEX_IPO_EXPECTED_DATE=2026-06-12
# SPACEX_IPO_LISTING_CACHE_HOURS=1
# SPACEX_IPO_AUTO_BUY=          # unset = on for paper only; false to disable
# SPACEX_IPO_BUY_NOTIONAL=2500
# Kraken Pro SPCX (xStock SPCXx/USD or equity pair via API)
# ALLOW_KRAKEN_TRADING=yes
# KRAKEN_SPCX_BUY_ENABLED=true
# KRAKEN_SPCX_BUY_USD=500
# KRAKEN_SPCX_PAIR=           # optional override; auto-detect if empty

# Kraken autopilot (live Pro + wisdom/game-plan gates) — see docs/KRAKEN_AUTOPILOT.md
# KRAKEN_AUTOPILOT_ENABLED=true
# KRAKEN_DRY_RUN=true          # default: validate only; set false for live orders
# KRAKEN_AUTOPILOT_CLEANUP=true
# KRAKEN_AUTOPILOT_CRYPTO_MIRROR=true
# KRAKEN_AUTOPILOT_MIRROR=true
# KRAKEN_MAX_ORDER_USD=25
# KRAKEN_CRYPTO_NOTIONAL=15
# KRAKEN_CLEANUP_MAX_ACTIONS=2
# KRAKEN_REBALANCE_ENABLED=true
# KRAKEN_REBALANCE_MAX_TRADES=4
# KRAKEN_REBALANCE_FORCE=false
# Edit targets: reference/kraken_targets.json
# WISDOM_EVAL_ENABLED=true
# WISDOM_EVAL_DAYS=30
# WISDOM_MONTHLY_ENABLED=true

# Alerts (optional — halt + daily summary)
# Telegram: message @BotFather, then get chat id from getUpdates after messaging your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kraken phone playbook: python scripts/kraken_send_playbook.py (see docs/KRAKEN_PHONE_ALERTS.md)

# Email alerts for the trading bot (Gmail: use an app password, not login password)
# Digest email for bullshitmeter is configured in that project's .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=you@gmail.com

# Holdings reconcile (run_all startup)
# RECONCILE_ON_STARTUP=true
# TRIM_OVER_CAP_ON_STARTUP=true
# REBALANCE_ON_STARTUP=false   # sell to targets + deploy SPY/NYSE on signals at startup

# Game plan (live default ON): yield gate + 10% metal sleeve + stress cash
# GAME_PLAN_ENABLED=true
# YIELD_GATE_ENABLED=true
# METAL_SLEEVE_CAP_PCT=0.10
# METAL_BLEND_GLD=0.50
# METAL_BLEND_SLV=0.30
# METAL_BLEND_CPER=0.20
# STRESS_CASH_PCT=0.25
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=
# Legacy alias also supported:
# KRAKEN_API_SECRET=
