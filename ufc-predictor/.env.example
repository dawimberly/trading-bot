# Copy to .env and fill in your keys (never commit .env)

# The Odds API — https://the-odds-api.com (live odds; cached lines supplement historical merge)
THE_ODDS_API_KEY=your_api_key_here

# Optional: override public Kaggle-style odds CSV mirrors used in historical merge
# ULTIMATE_UFC_DATASET_URL=https://raw.githubusercontent.com/shortlikeafox/ultimate_ufc_dataset/main/ufc-master.csv
# JANSEN_CLEANED_ODDS_URL=https://raw.githubusercontent.com/jansen88/ufc-data/master/data/cleaned_odds.csv

# NewsAPI — https://newsapi.org (optional fight commentary sentiment)
NEWS_API_KEY=your_news_api_key_here

# Model tuning (trading-bot style Optuna search)
OPTUNA_TRIALS=50
USE_ENSEMBLE=true
ENSEMBLE_WEIGHTS=0.55,0.45
CONFORMAL_ALPHA=0.10

# Prop betting (method, rounds, decision markets)
ENABLE_PROPS=true
PROP_MIN_EDGE=0.05
PROP_SYNTHETIC_VIG=0.08
PROP_PARLAY_MAX_LEGS_DK=3
ODDS_API_PROP_MARKETS=totals

# --- Path hints (usually auto-detected; set only if needed) ---
# Canonical standalone install:
#   UFC_CANONICAL_ROOT=C:\UFC-Predictor
# Monorepo (PythonTrading) — point bot at standalone copy:
#   UFC_CANONICAL_ROOT=C:\UFC-Predictor
# Legacy monorepo sibling layout:
#   UFC_PREDICTOR_DIR=../ufc-predictor
# Optional: paste browser Cookie header when BetNow hides guest odds
# BETNOW_COOKIE=

# MyBookie.ag (dashboard book tab + props)
MYBOOKIE_ENABLED=true
# MYBOOKIE_COOKIE=
# MYBOOKIE_UFC_URL=https://www.mybookie.ag/sportsbook/ufc/
# MYBOOKIE_PROPS_URL=https://www.mybookie.ag/sportsbook/ufc/props/
