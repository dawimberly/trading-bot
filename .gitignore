# --- Secrets (never commit; .env.example files are tracked on purpose) ---
.env
.env.*
!.env.example
!.env.portal.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
venv311/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Build artifacts (PyInstaller; ~92 MB, rebuilt on every launcher change) ---
build/
dist/
*.spec.bak

# --- Logs ---
logs/
*.log
!scripts/research/**/*.log

# --- Agent chat transcripts (~65 MB, not source) ---
chats/
trading-bot-chats/

# --- Bot runtime state: rewritten every cycle, conflicts on every pull ---
bot_heartbeat.json
*_heartbeat.json
*_heartbeat.json.lock
bot.pid
*.pid
*.lock
core_allocator_state.json
trading_safety_state.json
thinking_news_cache.json
crypto_vol_journal.csv
paper_journal.csv
paper_journal.csv.bak*
wisdom_journal.csv
wisdom_scorecard.json
*.tmp
*.tmp.*

# Per-user portal books hold live API keys and per-cycle state.
stock-bot/data/portal/users/

# --- Sentiment source sync state (re-fetched, not authored) ---
stock-bot/sentiment/sources/**/sync_state.json
stock-bot/sentiment/sources/**/manifest.jsonl

# --- Local editor / OS ---
.DS_Store
Thumbs.db
.idea/
# .cursor holds mcp.json with API keys; rules are shared via the repo copy.
.cursor/
.grok/

# --- Research OUTPUTS are intentionally tracked ---
# Keep: scripts/analysis/*.json|*.md, reports/, scripts/research/**/runs/*.md|*.json,
# docs/. These are results worth keeping, so no ignore rules for them.
