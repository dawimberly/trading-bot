# =============================================================================
# PythonTrading stock bot — .env template
# Copy to .env in this folder (stock-bot/) and fill secrets. Never commit .env.
#
# Quick start:
#   cd stock-bot
#   copy .env.example .env
#
# Live Profile A (~$100–$500 on Alpaca):
#   APCA_API_KEY_ID / APCA_API_SECRET_KEY, PAPER_TRADING=false, ALLOW_LIVE_TRADING=yes
#   Crypto sleeve is OFF by default (Profile A / small account — Alpaca crypto often disabled).
#
# Paper research (Profile B): PAPER_TRADING=true + PAPER_CHASE_MODE=1 (see PROFILE B below)
#
# Docs: README.md "Two deployment profiles", scripts/account/preflight.py
# =============================================================================

# --- Alpaca paper (default for first-time setup) ---
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
PAPER_TRADING=true
# When true, run_all.py / Weinstein-Trading-Bot.exe also opens dashboard_app.py (or PythonTradingMonitor.exe)
# AUTO_LAUNCH_DASHBOARD=false
# On dashboard open/reopen: clean-restart both portal books (owner_reset-style). Default true.
# Set false for old "monitor only" behavior. Start_Bot_and_Dashboard / owner_reset set this
# false in the child env so bots are not restarted twice.
# DASHBOARD_RESTART_BOTS_ON_OPEN=true
# On real quit (not tray minimize): stop live + paper. Default false (keeps overnight bots).
# DASHBOARD_STOP_BOTS_ON_CLOSE=false
# Positions tab cache TTL (seconds); heartbeat refresh skips fetch when cache is fresh / tab inactive
# DASHBOARD_POSITIONS_REFRESH_SEC=12
# Paper REST endpoint is forced to https://paper-api.alpaca.markets when PAPER_TRADING=true

# --- Alpaca live (Profile A) — uncomment and use INSTEAD of paper block above ---
# APCA_API_KEY_ID=your_live_key_id
# APCA_API_SECRET_KEY=your_live_secret_key
# PAPER_TRADING=false
# ALLOW_LIVE_TRADING=yes
# APCA_API_BASE_URL=https://api.alpaca.markets

# Optional: separate paper account for run_spy.py only
# SPY_APCA_API_KEY_ID=
# SPY_APCA_API_SECRET_KEY=
# Legacy: ALPACA_API_KEY=  ALPACA_SECRET_KEY=

# =============================================================================
# PROFILE A — LIVE CONSERVATIVE (alpaca_live)
# Use for live ~$100–$500 account, default run_all.py, preflight live.
# enforce_live_conservative_profile() applies when PAPER_TRADING=false.
# Paper Research v1.5.4 stays separate (aggressive) — do not mix stacks.
# config.py defaults match this block; uncomment only to override.
# =============================================================================

WISDOM_MODE=dynamic

# Live Conservative lock (default ON when live book runs):
# LIVE_CONSERVATIVE_ENABLED=true
# LIVE_VTI_CORE_PCT=0.85
# LIVE_SMALL_ACTIVE_SLEEVE_PCT=0.05
# LIVE_ACTIVE_SLEEVE_CHOICE=spy          # SPY trend path
# GARCH_VOL_LIVE_ENABLED=true           # set by live enforce unless env-explicit false
# ATR / exit optimization / correlation guard / tail risk: ON via live enforce
# Paper-only stay OFF: Stat Arb, shorts, RVOL/ORB/Catalyst, optional VTI 0% floor,
#   SPY-like boosts, ARIMA, Daily Banking (use *_LIVE_ENABLED=true only to opt in)

# RHYME regime detection (daily bars for label; 5m still used for trading vol score)
# REGIME_SENTIMENT_THRESHOLD=0.12
# REGIME_VOL_THRESHOLD_DAILY=0.02
# REGIME_VOL_THRESHOLD_5M=0.008
# REGIME_HYSTERESIS_ENABLED=true
# REGIME_MIN_DWELL_SEC=3600
# REGIME_DAILY_LOOKBACK_DAYS=120
GAME_PLAN_ENABLED=true
GAME_PLAN_YIELD_GATE_ONLY=true
YIELD_GATE_ENABLED=true
VTI_CORE_ENABLED=true
VTI_CORE_PCT=0.80

# Small account safety auto-applies when equity < $500 (e.g. ~$100 live):
# SMALL_ACCOUNT_EQUITY_THRESHOLD=500
# SMALL_ACCOUNT_RISK_PER_TRADE=0.01
# SMALL_ACCOUNT_MAX_NOTIONAL=10
# SMALL_ACCOUNT_VTI_CORE_PCT=0.85        # Live Conservative high-VTI floor (was 0.90 legacy)

# Live profile label (default A = current_dynamic; Alpaca crypto sleeve skipped for A / small account)
# TRADING_PROFILE=A

# Sleeves are in config.py (45/20/20/15%); override only for experiments:
# SPY_SLEEVE_CAP_PCT=0.45
# CRYPTO_SLEEVE_CAP_PCT=0.20
# NYSE_SLEEVE_CAP_PCT=0.20

# Profile A opt-in only (defaults OFF in config.py — enable individually after grids):
# SPY_EXIT_ON_MA_BREAK=true
# SPY_LADDER_SIZING_ENABLED=false
# NYSE_OVERLAP_FILTER_ENABLED=true
# NYSE_SPY_CORR_MAX=0.80
# NYSE_SPY_BETA_MAX=1.6
# NYSE_BETA_SCALING_ENABLED=true
# NYSE_SECTOR_TECH_CAP=0
# ADAPTIVE_CHUNK_ENABLED=true
# ADAPTIVE_CHUNK_MAX_PCT=0.05
# COFIRE_BUDGET_ENABLED=true
# COFIRE_BUDGET_PCT=0.06
# DYNAMIC_SLEEVE_CAPS_ENABLED=true

# Full game plan only (set GAME_PLAN_YIELD_GATE_ONLY=false):
# METAL_SLEEVE_CAP_PCT=0.10
# METAL_BLEND_GLD=0.50
# METAL_BLEND_SLV=0.30
# METAL_BLEND_CPER=0.20
# STRESS_CASH_PCT=0.25

# Risk / halt (shared by both profiles)
MAX_DRAWDOWN_PCT=0.10

# Real-time Alpaca WebSocket (paper default on, live off)
# REAL_TIME_WEBSOCKET_ENABLED=true
# REAL_TIME_FLUSH_SEC=5
# REAL_TIME_CRYPTO_WS=true
# REAL_TIME_MAX_NYSE_SYMBOLS=12
# REAL_TIME_SYMBOL_BATCH_SIZE=10
# REAL_TIME_MAX_RETRIES=5
# REAL_TIME_STALE_SEC=30
# REAL_TIME_USE_QUOTES=false
# REAL_TIME_DATA_FEED=iex
HALT_RESUME_DRAWDOWN_PCT=0.08
HALT_LIQUIDATE_ON_BREACH=true
HALT_TARGET_CASH_PCT=0.25
# STOP_LOSS_PCT=0.05
# CRYPTO_MIN_CORRELATION=0.5

# Sizing scales with account (tuned at REFERENCE_EQUITY=100000)
# RISK_PER_TRADE=0.02
# MAX_NOTIONAL_PER_ORDER=10000
# MIN_NOTIONAL=10
# ALPACA_MIN_NOTIONAL=1
# REFERENCE_EQUITY=100000
# ALPACA_CRYPTO_FEE_AWARE=true
# ALPACA_CRYPTO_TAKER_FEE_PCT=0.0025

# Regime / wisdom (Profile A default)
SENTIMENT_SOURCE=price
AUTO_DYNAMIC_ENABLED=true
SENTIMENT_GAP_THRESHOLD_AGGRESSIVE=0.25
SENTIMENT_GAP_THRESHOLD_NORMAL=0.35
SENTIMENT_GAP_THRESHOLD_DEFENSIVE=0.50
DYNAMIC_SIZING_MULTIPLIER_MAX=1.5
DYNAMIC_SIZING_MULTIPLIER_MIN=0.5
WISDOM_GAP_THRESHOLD=0.25
DERIVED_BEAR_PAUSE_ENABLED=false

# Cost basis + macro event guard
# COST_BASIS_AWARE_ENABLED=true
# UNDERWATER_SIZING_SCALE=0.75
# DISCRETIONARY_SELL_BELOW_COST=true
# MACRO_EVENT_GUARD_ENABLED=true
# MACRO_EVENT_HOURS_BEFORE=18
# MACRO_EVENT_SIZING_SCALE=0.7

# Wisdom evaluation
WISDOM_EVAL_ENABLED=true
WISDOM_EVAL_DAYS=30
WISDOM_MONTHLY_ENABLED=true

# Holdings reconcile (run_all startup)
RECONCILE_ON_STARTUP=true
TRIM_OVER_CAP_ON_STARTUP=true
# REBALANCE_ON_STARTUP=false

# Scan schedule (run_all.py): crypto overnight; SPY/NYSE around US open (ET)
# SCAN_SCHEDULE_ENABLED=true
# EQUITY_SCAN_BEFORE_OPEN_MIN=5
# EQUITY_SCAN_AFTER_OPEN_MIN=5
# CYCLE_INTERVAL_SEC=60
# CRYPTO_ONLY_CYCLE_INTERVAL_SEC=300
# VTI_CORE_REBALANCE_DRIFT_PCT=0.02

# =============================================================================
# PROFILE B — REALISTIC RESEARCH v1.5.4 (FINAL LOCK — official paper default)
# config.enforce_realistic_research_profile() applies these when PAPER_CHASE_MODE=1.
# Tagline: v1.5.4 — Sector-Aware Portfolio Constructor
# 365d tune lock: Stat Arb quality ON | ARIMA OFF | optional VTI ON | SPY-like ON (paper)
# Live stays conservative: optional VTI / SPY-like / ARIMA / GARCH live OFF unless opt-in.
# =============================================================================
#
# REALISTIC_RESEARCH_VERSION=1.5.4
# PAPER_CHASE_MODE=1
# PAPER_AGGRESSIVE=true
#
# --- v1.5 scanners (paper only) ---
# RVOL_SCANNER_ENABLED=true
# RVOL_MIN_THRESHOLD=2.0
# RVOL_MOMENTUM_BOOST_THRESHOLD=2.5
# ORB_ENABLED=true
# ORB_BREAKOUT_MINUTES=30
# ORB_RVOL_MIN=2.0
# CATALYST_SCORING_ENABLED=true
# CATALYST_MIN_SCORE=65
# ATR_SIZING_ENABLED=true
# ATR_PERIOD=14
# ATR_RISK_MULTIPLE=2.0
# ATR_MAX_SIZE_PCT=0.04
#
# --- Shorts + insider (v1.4 base, locked in v1.5) ---
# PROTECTIVE_SHORT_MIN_PCT=0.08
# PROTECTIVE_SHORT_MAX_PCT=0.18
# SECTOR_SHORT_ENABLED=true
# INSIDER_MONITOR_ENABLED=true
# INSIDER_SIGNAL_BOOST_ENABLED=true
# INSIDER_CLUSTER_MIN_BUYERS=2
#
# --- Monitoring + attribution ---
# STRATEGY_METRICS_DB=data/strategy_metrics.db
# HISTORICAL_NEWS_ENABLED=true
# HISTORICAL_NEWS_CACHE_DIR=data/historical_news_cache
# TELEGRAM_WEEKLY_SUMMARY_ENABLED=true
#
# --- Saturday weekly self-improvement review (paper; never auto-applies .env) ---
# WEEKLY_REVIEW_ENABLED=true
# WEEKLY_REVIEW_OPEN=true
# WEEKLY_REVIEW_TARGET_SHARPE=1.0
# WEEKLY_REVIEW_MAX_DD_PCT=15
# WEEKLY_REVIEW_TARGET_RETURN_PCT=0.5
# WEEKLY_REVIEW_MIN_TRADES=5
# WEEKLY_REVIEW_NYSE_QUALITY_SECTION=true
# Install viewer task: powershell -File scripts/analysis/install_weekly_review_task.ps1
#
# --- Dynamic NYSE screener throughput ---
# SCREENER_MARKET_CAP_MODE=off   # off|cache|fetch (off avoids slow yf.Ticker.info)
# Prefetch after screen: automatic via scripts/analysis/universe_screener.py
#
# --- Auto-recovery / watchdog (fixes "Bot not responding") ---
# HEARTBEAT_WATCHDOG_ENABLED=true       # force-restart engine if a cycle hangs
# HEARTBEAT_WATCHDOG_TIMEOUT_SEC=90     # stall threshold before restart
# PAPER_SUPERVISOR_AUTORESTART=true     # run_paper_bot restarts engine on crash/watchdog
#
# --- Conviction sizing (scales position size by signal strength) ---
# CONVICTION_SIZING_ENABLED=true
# CONVICTION_MIN_SCALE=0.4
# CONVICTION_MAX_SCALE=1.8
#
# --- Multi-timeframe confirmation (5m / daily / weekly alignment) ---
# MULTI_TIMEFRAME_ENABLED=true
# MULTI_TIMEFRAME_MIN_ALIGNMENT=0.65
# MULTI_TIMEFRAME_BOOST_FACTOR=0.22
#
# --- Exit optimization (partial @1R, dynamic trail, time exit) ---
# EXIT_OPTIMIZATION_ENABLED=true
# PARTIAL_EXIT_RR=1.0
# TRAIL_ARM_PCT=0.50
# TRAIL_PULLBACK_PCT=0.35
# EXIT_OPTIMIZATION_MAX_HOLD_BARS=35
#
# --- Portfolio correlation guard ---
# CORRELATION_GUARD_ENABLED=true
# MAX_PORTFOLIO_CORR=0.65
# CORR_GUARD_MIN_SCALE=0.60
# CORR_GUARD_CEILING=0.85
#
# Recover a stuck bot: python scripts/recover_bot.py
# Paper-only reset:    python scripts/owner_reset.py --paper-only --verify
# Monday Ready: python scripts/full_system_verify.py && python scripts/owner_reset.py
# Overnight: Start_Autonomous.bat
#
# =============================================================================
# REALISTIC RESEARCH v1.1 legacy notes (superseded by v1.5 locks above)
# =============================================================================
#
# CORE_ALLOCATOR_LOCKED=true
# CORE_ALLOCATOR_LOCKED_CHOICE=spy
# PAPER_VTI_CORE_PCT=0.40
# DEEP_HISTORY_ENABLED=true
# DEEP_HISTORY_INDICATORS_ONLY=true
# RISK_PER_TRADE=0.018
# PAPER_RISK_PER_TRADE=0.018
# PAPER_POSITION_MAX_HOLD_BARS=30
# PAPER_REGIME_B_SIZING_MULT=0.30
# PAPER_REGIME_B_RISK_MULT=0.50
# TAIL_RISK_CONTROLS_ENABLED=true
# VOL_CEILING_ENABLED=true
# PAPER_VOL_CEILING_PCT=0.17
# PORTFOLIO_VOL_CEILING_PCT=0.18
# PAPER_DD_RISK_WARN_PCT=0.05
# PAPER_DD_RISK_MULT_5=0.6
# PAPER_DD_RISK_SEVERE_PCT=0.08
# PAPER_DD_RISK_MULT_8=0.3
# PER_NAME_MAX_PCT=0.08
# PAPER_REGIME_B_CASH_BUFFER_BOOST=0.12
# WISDOM_LAYER_ENABLED=false
# COT_OVERLAY_ENABLED=false
# DYNAMIC_CORE_ENABLED=false
# PAPER_DYNAMIC_VTI=false
# STAT_ARB_ENABLED=true
# THINKING_ENGINE_ENABLED=false
#
# Optional Kimi deep thinker (daily only — not 5m loop; billed per token)
# KIMI_API_ENABLED=false
#
# --- Moonshot direct ---
# KIMI_API_KEY=your_moonshot_api_key
# KIMI_MODEL=kimi-latest
# KIMI_API_BASE_URL=https://api.moonshot.ai/v1
#
# --- NVIDIA NIM (integrate.api.nvidia.com) ---
# KIMI_API_ENABLED=true
# NVIDIA_API_KEY=nvapi-your_key_here
# KIMI_API_BASE_URL=https://integrate.api.nvidia.com/v1
# KIMI_MODEL=moonshotai/kimi-k2.6
# KIMI_TEMPERATURE=0.3
# KIMI_MAX_TOKENS=4096
# KIMI_TOP_P=1.0
# KIMI_DAILY_THINK=true
# PAPER_THINKING_ENGINE_ENABLED=true
#
# Live Profile A stays conservative. See config.print_live_stack_flags().
# =============================================================================
#
# --- Legacy high-frequency profile (more active sleeve room, less passive core) ---
# PAPER_VTI_CORE_PCT=0.20
# PAPER_DYNAMIC_VTI=false
# PAPER_STAT_ARB_ENABLED=true
#
# PAPER_SOFT_PAUSE=true
# PAPER_SOFT_PAUSE_SIZING_MULT=0.50
# PAPER_DYNAMIC_UNIVERSE_ENABLED=true  # weekly NYSE+NASDAQ screener (paper only; default true)
# PAPER_DYNAMIC_UNIVERSE_STRICT=true    # quality screener: 8-12 names, 30d momentum, sector balance (paper only)
# PAPER_DYNAMIC_UNIVERSE_MIN_COVER=10   # merge with static NYSE when screener overlap < this (fixes scan_signals=0)
# STAT_ARB_MIN_UNIVERSE=20              # floor for stat-arb pair pool (merge static when below)
# STAT_ARB_MAX_SCAN_UNIVERSE=80         # cap O(n^2) pair scan; static NYSE core kept first
# Dynamic universe (paper only — combines fixed + screener top 75)
USE_DYNAMIC_UNIVERSE=false
# NYSE momentum entry quality (paper only): open cooldown 9:30-10:00 ET, >2% gap skip,
# one entry/symbol/day, exit_reason journal column. Default off.
PAPER_MOMENTUM_QUALITY_FIXES=false
# PAPER_IPO_SAFETY_ENABLED=true         # IPO caps: 2% max, 0.5x sizing, trim at +20% to 1% (paper default on)
# CRYPTO_SLEEVE_ENABLED=false          # Crypto sleeve disabled - underperformed in all backtests
# PAPER_CRYPTO_ENABLED=false           # Same for paper Profile B (stat-arb pairs path)
# PAPER_CRYPTO_UNIVERSE_EXPANDED=false  # DISABLED on bots — research only (--compare-crypto-universe)
# PAPER_PROFIT_TARGET_ENABLED=false     # DISABLED on bots — research only (--compare-profit-target)

# Paper-only GARCH(1,1) vol-target position sizing (NYSE + crypto_vol sleeves).
# Off by default — enable after scripts/research/backtest_intraday.py --garch-test.
PAPER_GARCH_SIZING=false
GARCH_TARGET_VOL=0.15
GARCH_MIN_MULTIPLIER=0.5
GARCH_MAX_MULTIPLIER=1.5

# PAPER_DYNAMIC_RISK_ENABLED=true   # paper ~1.8% calm / 1.05% mod / 0.7% stress (live Profile A separate)
# PAPER_DYNAMIC_VTI=true          # LOCKED paper default: Smart Dynamic VTI 40-75% (hard floor >=40%)
# DYNAMIC_VTI_PAPER_FLOOR=0.40
# DYNAMIC_VTI_PAPER_CEILING=0.75
# DYNAMIC_VTI_STRESS_PCT=0.75       # macro stress or vol > 2.5%
# DYNAMIC_VTI_DEFAULT_PCT=0.65      # default aggressive paper
# DYNAMIC_VTI_CALM_PCT=0.50         # calm bull vol < 1.5% (wider active sleeves)
# DYNAMIC_VTI_ALLOW_ZERO=false      # hard floor >=40% (zero-core path retired for lock)
# DYNAMIC_VTI_FLOOR_MIN=0.40
# DYNAMIC_VTI_OPTIONAL_ENABLED=true # floor reductions capped by FLOOR_MIN (40%)
# SPY_LIKE_UNIVERSE=SPY,QQQ,VTI,VOO,IWM,AAPL,MSFT,NVDA,GOOGL,AMZN,META,AVGO
# SPY_LIKE_BOOST_ENABLED=true       # 1.05–1.2x when RVOL+ORB+Catalyst+insider confluence
# SPY_LIKE_BOOST_LIVE_ENABLED=false # live stays off unless opt-in
# DYNAMIC_VTI_OPTIONAL_LIVE=false
# PAPER_SMALL_ACCOUNT_VTI_PCT=0.90  # equity < SMALL_ACCOUNT_EQUITY_THRESHOLD
# Set PAPER_DYNAMIC_VTI=false + PAPER_VTI_CORE_PCT=0.80 for fixed 80/20 research A/B only
# PAPER_DYNAMIC_RISK_ENABLED=true   # 3% calm bull / 2.2% moderate / 1% stress (paper only)
# PAPER_NYSE_OVERLAP_FILTER_ENABLED=true
# PAPER_ADAPTIVE_CHUNK_ENABLED=true
# PAPER_COFIRE_BUDGET_ENABLED=true
# PAPER_SPY_EXIT_ON_MA_BREAK=false
# PAPER_STAT_ARB_ENABLED=true       # cointegration + Z-score pairs (paper aggressive only)
#                                   # default path: MA50 momentum + stat arb (PAPER_EQUITY_PAIRS=false)
#                                   # pairs-only: set PAPER_EQUITY_PAIRS=true (replaces momentum singles)
# PAPER_PAIR_MIN_CORRELATION=0.65
# PAPER_PAIR_Z_THRESHOLD=2.0
# PAPER_PAIR_Z_DYNAMIC=true
# PAPER_PAIR_Z_CALM=1.8
# PAPER_PAIR_Z_STRESS=2.4
# PAPER_PAIR_COINT_SLOPE=-0.01
# PAPER_STAT_ARB_MAX_TRADES=2
# PAPER_STAT_ARB_MIN_CORR=0.68          # v1.5.4 quality: keep fill-rate corr floor
# PAPER_STAT_ARB_MAX_PAIRS=8            # base; expands to 12 when no_room rate is low
# PAPER_STAT_ARB_MAX_PAIRS_EXPANDED=12
# PAPER_STAT_ARB_MAX_PAIRS_CEILING=12
# PAPER_STAT_ARB_MAX_HOLD_BARS=35
# PAPER_STAT_ARB_EQUITY_MAX_HOLD_BARS=35
# PAPER_STAT_ARB_Z_ENTRY_BASE=2.1       # dynamic Z entry 2.1-2.7 (+ stronger vol filter)
# PAPER_STAT_ARB_Z_ENTRY_MAX=2.7
# PAPER_STAT_ARB_RISK_REWARD=1.7        # profit : stop (Z-space)
# PAPER_STAT_ARB_TRAILING_ARM_FRAC=0.45
# PAPER_STAT_ARB_TRAILING_PULLBACK_FRAC=0.30
# PAPER_STAT_ARB_PARTIAL_EXIT=true
# PAPER_STAT_ARB_PARTIAL_EXIT_RR=1.2    # partial at 1.2R vs stop (Z-space)
# PAPER_STAT_ARB_MAX_LEG_VOL=0.055
# PAPER_STAT_ARB_CONVICTION_MIN_SCALE=0.60
# PAPER_STAT_ARB_CONVICTION_MAX_SCALE=1.40
# PAPER_STAT_ARB_COINT_PVALUE=0.12
# PAPER_STAT_ARB_MIN_DOLLAR_VOLUME=50000000
# STAT_ARB_SLEEVE_CAP_ENABLED=true
# STAT_ARB_SLEEVE_CAP_PCT=0.07
# STAT_ARB_VOL_SCALING_ENABLED=true

# --- Insider & filings monitor (paper only; SEC EDGAR RSS) ---
# INSIDER_MONITOR_ENABLED=true
# INSIDER_SIGNAL_BOOST_ENABLED=true
# INSIDER_RISK_GUARD_ENABLED=true
# TELEGRAM commands (paper only): /signals /insider /boosts /status — polled each cycle
# INSIDER_CLUSTER_BOOST_MAX=0.18
# INSIDER_SELL_SHORT_BOOST_MAX=0.30
# INSIDER_CLUSTER_MIN_BUYERS=2
# INSIDER_MONITOR_POLL_HOURS=5
# INSIDER_MONITOR_LOOKBACK_DAYS=7
# SEC_USER_AGENT=PythonTradingBot/1.0 (you@example.com)   # SEC requires contact email
# STAT_ARB_SLEEVE_CAP_ENABLED=true      # dedicated cap (paper/research)
# STAT_ARB_SLEEVE_CAP_PCT=0.07          # 7% dedicated (~5.6% effective @ 40% core)
# STAT_ARB_VOL_SCALING_ENABLED=true     # scale 50-70% when 20d vol > 18%
# STAT_ARB_VOL_MIN_NOTIONAL_SCALE=0.30
# PAPER_PAIR_Z_EXIT=0.5
# STAT_ARB_LOOKBACK=60
# PAPER_MARKET_NEUTRAL_PAIRS=true   # legacy corr pairs (off when stat arb on)
# PAPER_EQUITY_PAIRS=false          # long strong / short weak NYSE pairs (opt-in)
# PAPER_SOCIAL_SLEEVE_ENABLED=false       # static always-on (prefer dynamic below)
# FELIX_SOCIAL_DYNAMIC_ENABLED=true       # paper default: ON in RHYME_E or bubble>=65; OFF in C/D
# FELIX_SOCIAL_DYNAMIC_BUBBLE_THRESHOLD=65
# FELIX_SOCIAL_MANUAL_OVERRIDE=false
# MARKOV_HMM_ENABLED=true                 # paper default: 5-state GaussianHMM soft-signals (VTI/sizing/shorts)
# MARKOV_HMM_PRIMARY_REGIME=false         # RHYME stays primary (locked). Optional research-only RHYME replacement — keep false
# MARKOV_HMM_PRIMARY_MIN_CONFIDENCE=0.40  # min HMM confidence to replace RHYME when primary ON (research only)
# HMM_N_STATES=5
# HMM_TRAIN_WINDOW_DAYS=252
# HMM_PREDICTION_HORIZON=1
# MARKOV_HMM_LIVE_ENABLED=false           # live stays off unless explicitly enabled
# HMM_OBSERVATIONS=returns,vol,sentiment,bubble,sector_corr,tod_bucket,overnight_gap
# TIME_OF_DAY_ANALYSIS=true               # paper: session-bucket edges for entries/Stat Arb/Markov
# TIME_OF_DAY_LIVE_ENABLED=false          # live stays off unless explicitly enabled
# DAILY_BANK_ENABLED=true                 # paper: bank day gains >=0.8%, risk x0.4 rest of day
# DAILY_BANK_THRESHOLD_PCT=0.8            # percent points (0.8 => 0.8%)
# DAILY_BANK_RISK_MULT=0.4
# DAILY_BANK_RESET_MINUTES_AFTER_OPEN=30
# DAILY_BANK_VTI_BOOST_PP=10              # nudge VTI core when banked
# DAILY_BANK_LIVE_ENABLED=false           # live stays off unless explicitly enabled
# GARCH_VOL_ENABLED=true                  # LOCKED paper: GARCH(1,1) next-day σ → size/VTI mult (high vol → smaller)
# GARCH_VOL_LIVE_ENABLED=true             # Live Conservative default ON via enforce_live; set false to disable
# DYNAMIC_VTI_OPTIONAL_LIVE=false         # live keeps high VTI floor (no 0% optional floor)
# SPY_LIKE_BOOST_LIVE_ENABLED=false       # live stays off unless opt-in
# ORB_MOMENTUM_LIVE_SLEEVE=false          # aggressive scanners stay paper-only
# GARCH_VOL_SYMBOL=SPY
# GARCH_VOL_LOOKBACK=252
# GARCH_VOL_ANCHOR_WINDOW=21              # rolling realized-vol median anchor
# GARCH_VOL_RETRAIN_EVERY_BARS=5          # recalibrate α/β every N bars
# GARCH_VOL_MULT_MIN=0.55                 # floor size mult at elevated forecast vol
# GARCH_VOL_MULT_MAX=1.0                  # cap (1.0 = never size UP vs baseline)
# GARCH_VOL_RATIO_LOW=0.85                # forecast/anchor <= this → mult_max
# GARCH_VOL_RATIO_HIGH=1.35               # forecast/anchor >= this → mult_min
# GARCH_VOL_VTI_SCALE_PP=8                # VTI pp nudge per unit (ratio-1)
# GARCH_VOL_VTI_MAX_PP=6                  # clamp |VTI adj|
# GARCH_VOL_CONVICTION_BLEND=0.35         # soft-trim conviction regime component
# ARIMA_ENABLED=false                     # FINAL LOCK default OFF (365d: ON worse); set true to opt in
# ARIMA_LIVE_ENABLED=false                # live stays off unless explicitly enabled
# ARIMA_GARCH_HYBRID=true                 # when ARIMA on: scale mean boost by GARCH ratio (no double GARCH)
# ARIMA_SYMBOL=SPY
# ARIMA_WINDOW=252                        # rolling lookback (alias: ARIMA_LOOKBACK)
# ARIMA_ORDER=1,0,1                       # fallback tries 1,1,1 then last return
# ARIMA_RETRAIN_EVERY_BARS=5
# ARIMA_BOOST_MULT=1.08                   # size mult when next-step mean forecast > 0
# ARIMA_NEG_MULT=1.0                      # neutral when forecast <= 0 (no size-up)
# ARIMA_MULT_MAX=1.15                     # hard cap on positive / hybrid boost
# ARIMA_HYBRID_MULT_MIN=0.55              # floor when hybrid combines mean×vol
# ARIMA_HYBRID_VOL_SCALE_FLOOR=0.0        # vol_scale at high GARCH ratio (0=neutralize boost)
# ARIMA_CONVICTION_BLEND=0.25             # soft-lift conviction regime when boosted
#
# --- Strategy rating feedback + paper param opt (opt-in; default OFF) ---
# Scores sleeves from journals / strategy_metrics over lookback → size mult 0.8–1.2.
# Paper: STRATEGY_RATING_ENABLED=true | Live stays off unless STRATEGY_RATING_LIVE_ENABLED.
# CLI: python scripts/analysis/run_strategy_rating_opt.py --days 365
#      python scripts/analysis/run_strategy_rating_opt.py --days 365 --backtest --fast-mode --sample 6
# STRATEGY_RATING_ENABLED=false
# STRATEGY_RATING_LIVE_ENABLED=false
# STRATEGY_RATING_LOOKBACK_DAYS=365
# STRATEGY_RATING_MULT_MIN=0.8
# STRATEGY_RATING_MULT_MAX=1.2
# STRATEGY_RATING_MIN_TRADES=5
# STRATEGY_RATING_CACHE_SEC=3600
# STRATEGY_RATING_STACK_BLEND=0.5
# STRATEGY_RATING_APPLY_STACK_RISK=true
# PAPER_SMART_STOPS=true                  # paper: ATR stop 2.0x; reeval @-5% / hard @-10%
# ATR_STOP_MULTIPLIER=2.0
# ATR_TIGHTEN_MULTIPLIER=1.0              # high-conviction tighten at -5%
# STOP_LOSS_REEVAL_PCTS=[-5,-10]          # soft reeval, then hard full exit
# SMART_STOPS_LIVE_ENABLED=false          # live stays off unless explicitly enabled
# FELIX_SOCIAL_DYNAMIC_BUBBLE_THRESHOLD=65
# FELIX_SOCIAL_MANUAL_OVERRIDE=false      # force social ON even in RHYME_C/D
# PAPER_SOCIAL_MACRO_BOOST_ENABLED=true   # enhanced Felix macro weights (paper aggressive)
# SOCIAL_BEARISH_GLD_THRESHOLD=-0.6       # strong bear + macro keywords -> GLD (paper only)
# SOCIAL_BEAR_GLD_THRESHOLD=-0.12
# PAPER_MACRO_REGIME_ADAPTOR_ENABLED=true   # Best Paper Bot default (regime shift detector)
# PAPER_VOL_TRADING_ENABLED=true      # VIX overlay: short VXX calm / protection stress (paper only)
# POSITIONING_OVERLAY_ENABLED=false     # COT contrarian tilt (default off; COT_OVERLAY_ENABLED alias)
# DYNAMIC_CORE_ENABLED=true             # VTI/SPY/blend/cash core picker (paper default)
# DYNAMIC_CORE_LIVE_ENABLED=false       # set true to enable on live Profile A
# DYNAMIC_CORE_REVIEW_DAYS=30
# DYNAMIC_CORE_LOOKBACK_DAYS=63
# POSITIONING_OVERLAY_LIVE_ENABLED=false  # set true to enable on live Profile A
# COT_DATA_FILE=reference/cot_es.json
# COT_NET_SHORT_THRESH=-0.08          # large-spec net short → bullish tilt
# COT_NET_LONG_THRESH=0.08
# VOL_SLEEVE_CAP_PCT=0.08             # 5-10% of equity
# VOL_VIX_HIGH_THRESHOLD=20
# VOL_VIX_CALM_THRESHOLD=15
# PAPER_OPTIONS_SLEEVE_ENABLED=true   # covered calls on VTI/SPY (paper aggressive only)
# OPTIONS_SLEEVE_CAP_PCT=0.12         # 10-15% of equity
# OPTIONS_OTM_PCT=0.075               # 5-10% OTM strike
# OPTIONS_VIX_CALM_MAX=22             # sell calls only when VIX below this
# PAPER_WHEEL_SLEEVE_ENABLED=false    # CSP→assignment→CC wheel (paper opt-in)
# WHEEL_SLEEVE_CAP_PCT=0.08
# WHEEL_UNDERLYINGS=SPY,QQQ
# WHEEL_OTM_PCT=0.05
# PAPER_POLITICIAN_COPY_ENABLED=false # Capitol Trades copy (paper opt-in)
# POLITICIAN_COPY_CAP_PCT=0.05
# POLITICIAN_COPY_MAX_NAME_PCT=0.02
# POLITICIAN_COPY_TOP_TRADERS=5
# POLITICIAN_COPY_MAX_PER_DAY=2
# MACRO_OIL_SURGE_PCT=0.08
# MACRO_SAFE_HAVEN_CAP_PCT=0.12
# SOCIAL_MACRO_OVERRIDES_ENABLED=true
# SOCIAL_MACRO_BEAR_OVERRIDE_SCORE=-0.4
# SOCIAL_MACRO_BULL_OVERRIDE_SCORE=0.5
# PAPER_SOCIAL_SLEEVE_CAP_PCT=0.20
# PAPER_ACTIVE_SLEEVE_BOOST=1.40
# PAPER_CRYPTO_ENABLED=false
# Set true only when testing crypto pairs (--paper-crypto on backtester)
