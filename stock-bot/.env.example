# =============================================================================
# PythonTrading stock bot — .env template
# Copy to .env in this folder (stock-bot/) and fill secrets. Never commit .env.
#
# Quick start:
#   cd stock-bot
#   copy .env.example .env
#
# Live Profile A (~$100–$500 on Alpaca):
#   APCA_API_KEY_ID / APCA_API_SECRET_KEY, PAPER_TRADING=false, ALLOW_LIVE_TRADING=yes
#   Crypto sleeve is OFF by default (Profile A / small account — Alpaca crypto often disabled).
#
# Paper research (Profile B): PAPER_TRADING=true + PAPER_CHASE_MODE=1 (see PROFILE B below)
#
# Docs: README.md "Two deployment profiles", scripts/account/preflight.py
# =============================================================================

# --- Alpaca paper (default for first-time setup) ---
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
PAPER_TRADING=true
# Paper REST endpoint is forced to https://paper-api.alpaca.markets when PAPER_TRADING=true

# --- Alpaca live (Profile A) — uncomment and use INSTEAD of paper block above ---
# APCA_API_KEY_ID=your_live_key_id
# APCA_API_SECRET_KEY=your_live_secret_key
# PAPER_TRADING=false
# ALLOW_LIVE_TRADING=yes
# APCA_API_BASE_URL=https://api.alpaca.markets

# Optional: separate paper account for run_spy.py only
# SPY_APCA_API_KEY_ID=
# SPY_APCA_API_SECRET_KEY=
# Legacy: ALPACA_API_KEY=  ALPACA_SECRET_KEY=

# =============================================================================
# PROFILE A — LIVE DEFAULTS (current_dynamic)
# Use for live ~$100 account, default run_all.py, preflight live.
# config.py defaults match this block; uncomment only to override.
# =============================================================================

WISDOM_MODE=dynamic
GAME_PLAN_ENABLED=true
GAME_PLAN_YIELD_GATE_ONLY=true
YIELD_GATE_ENABLED=true
VTI_CORE_ENABLED=true
VTI_CORE_PCT=0.80

# Small account safety auto-applies when equity < $500 (e.g. ~$100 live):
# SMALL_ACCOUNT_EQUITY_THRESHOLD=500
# SMALL_ACCOUNT_RISK_PER_TRADE=0.01
# SMALL_ACCOUNT_MAX_NOTIONAL=10
# SMALL_ACCOUNT_VTI_CORE_PCT=0.90

# Live profile label (default A = current_dynamic; Alpaca crypto sleeve skipped for A / small account)
# TRADING_PROFILE=A

# Sleeves are in config.py (45/20/20/15%); override only for experiments:
# SPY_SLEEVE_CAP_PCT=0.45
# CRYPTO_SLEEVE_CAP_PCT=0.20
# NYSE_SLEEVE_CAP_PCT=0.20

# Profile A opt-in only (defaults OFF in config.py — enable individually after grids):
# SPY_EXIT_ON_MA_BREAK=true
# SPY_LADDER_SIZING_ENABLED=false
# NYSE_OVERLAP_FILTER_ENABLED=true
# NYSE_SPY_CORR_MAX=0.80
# NYSE_SPY_BETA_MAX=1.6
# NYSE_BETA_SCALING_ENABLED=true
# NYSE_SECTOR_TECH_CAP=0
# ADAPTIVE_CHUNK_ENABLED=true
# ADAPTIVE_CHUNK_MAX_PCT=0.05
# COFIRE_BUDGET_ENABLED=true
# COFIRE_BUDGET_PCT=0.06
# DYNAMIC_SLEEVE_CAPS_ENABLED=true

# Full game plan only (set GAME_PLAN_YIELD_GATE_ONLY=false):
# METAL_SLEEVE_CAP_PCT=0.10
# METAL_BLEND_GLD=0.50
# METAL_BLEND_SLV=0.30
# METAL_BLEND_CPER=0.20
# STRESS_CASH_PCT=0.25

# Risk / halt (shared by both profiles)
MAX_DRAWDOWN_PCT=0.10
HALT_RESUME_DRAWDOWN_PCT=0.08
HALT_LIQUIDATE_ON_BREACH=true
HALT_TARGET_CASH_PCT=0.25
# STOP_LOSS_PCT=0.05
# CRYPTO_MIN_CORRELATION=0.5

# Sizing scales with account (tuned at REFERENCE_EQUITY=100000)
# RISK_PER_TRADE=0.02
# MAX_NOTIONAL_PER_ORDER=10000
# MIN_NOTIONAL=10
# ALPACA_MIN_NOTIONAL=1
# REFERENCE_EQUITY=100000
# ALPACA_CRYPTO_FEE_AWARE=true
# ALPACA_CRYPTO_TAKER_FEE_PCT=0.0025

# Regime / wisdom (Profile A default)
SENTIMENT_SOURCE=price
AUTO_DYNAMIC_ENABLED=true
SENTIMENT_GAP_THRESHOLD_AGGRESSIVE=0.25
SENTIMENT_GAP_THRESHOLD_NORMAL=0.35
SENTIMENT_GAP_THRESHOLD_DEFENSIVE=0.40
DYNAMIC_SIZING_MULTIPLIER_MAX=1.5
DYNAMIC_SIZING_MULTIPLIER_MIN=0.5
WISDOM_GAP_THRESHOLD=0.25
DERIVED_BEAR_PAUSE_ENABLED=false

# Cost basis + macro event guard
# COST_BASIS_AWARE_ENABLED=true
# UNDERWATER_SIZING_SCALE=0.75
# DISCRETIONARY_SELL_BELOW_COST=true
# MACRO_EVENT_GUARD_ENABLED=true
# MACRO_EVENT_HOURS_BEFORE=18
# MACRO_EVENT_SIZING_SCALE=0.7

# Wisdom evaluation
WISDOM_EVAL_ENABLED=true
WISDOM_EVAL_DAYS=30
WISDOM_MONTHLY_ENABLED=true

# Holdings reconcile (run_all startup)
RECONCILE_ON_STARTUP=true
TRIM_OVER_CAP_ON_STARTUP=true
# REBALANCE_ON_STARTUP=false

# Scan schedule (run_all.py): crypto overnight; SPY/NYSE around US open (ET)
# SCAN_SCHEDULE_ENABLED=true
# EQUITY_SCAN_BEFORE_OPEN_MIN=5
# EQUITY_SCAN_AFTER_OPEN_MIN=5
# CYCLE_INTERVAL_SEC=60
# CRYPTO_ONLY_CYCLE_INTERVAL_SEC=300
# VTI_CORE_REBALANCE_DRIFT_PCT=0.02

# =============================================================================
# =============================================================================
# PROFILE B — PAPER RESEARCH OVERRIDES (paper_aggressive / Sharpe chase)
# Use for paper book, run_paper_bot.py, portal paper user, backtester --paper-aggressive.
# Does NOT change live Profile A unless PAPER_CHASE_MODE is set on the live .env.
#
# Validated Best Paper Bot v2.1 defaults (config/best_paper_config.py):
#   ON:  dynamic VTI/risk, stat arb, vol, options, overlap/chunk/co-fire, dynamic universe, IPO safety
#   OFF: crypto (locked), international ADR (default), bond (default), macro/social/risk parity
#   Opt-in only: PAPER_THINKING_ENGINE_ENABLED, PAPER_INTERNATIONAL_SLEEVE_ENABLED, PAPER_BOND_SLEEVE_ENABLED
# =============================================================================

# PAPER_CHASE_MODE=1
# PAPER_AGGRESSIVE=true
# PAPER_VTI_CORE_PCT=0.20
# PAPER_DYNAMIC_VTI=true
# PAPER_DYNAMIC_UNIVERSE_ENABLED=true  # weekly NYSE+NASDAQ screener (paper only; default true)
# PAPER_DYNAMIC_UNIVERSE_STRICT=true    # quality screener: 8-12 names, 30d momentum, sector balance (paper only)
# PAPER_IPO_SAFETY_ENABLED=true         # IPO caps: 2% max, 0.5x sizing, trim at +20% to 1% (paper default on)
# CRYPTO_SLEEVE_ENABLED=false          # Crypto sleeve disabled - underperformed in all backtests
# PAPER_INTERNATIONAL_SLEEVE_ENABLED=false   # default off (365d final: -0.38pp vs baseline; research opt-in only)
# PAPER_BOND_SLEEVE_ENABLED=false            # optional risk-off hedge (365d: flat return, modest MaxDD help)
# BOND_SLEEVE_SYMBOL=TLT
# BOND_SLEEVE_CAP_PCT=0.15
# BOND_VIX_TRIGGER_MIN=22
# INTERNATIONAL_SLEEVE_CAP_PCT=0.10
# PAPER_CRYPTO_UNIVERSE_EXPANDED=false  # DISABLED on bots — research only (--compare-crypto-universe)
# PAPER_PROFIT_TARGET_ENABLED=false     # DISABLED on bots — research only (--compare-profit-target)
# PAPER_PROFIT_TARGET_ENABLED=false     # DISABLED on bots — research only (--compare-profit-target)
# PAPER_DYNAMIC_RISK_ENABLED=true   # 3% calm bull / 2.2% moderate / 1% stress (paper only)
# DYNAMIC_VTI_PAPER_FLOOR=0.40
# PAPER_NYSE_OVERLAP_FILTER_ENABLED=true
# PAPER_ADAPTIVE_CHUNK_ENABLED=true
# PAPER_COFIRE_BUDGET_ENABLED=true
# PAPER_SPY_EXIT_ON_MA_BREAK=false
# PAPER_STAT_ARB_ENABLED=true       # cointegration + Z-score pairs (paper aggressive only)
# PAPER_PAIR_MIN_CORRELATION=0.75
# PAPER_PAIR_Z_THRESHOLD=2.5
# PAPER_PAIR_Z_EXIT=0.5
# STAT_ARB_LOOKBACK=60
# PAPER_MARKET_NEUTRAL_PAIRS=true   # legacy corr pairs (off when stat arb on)
# PAPER_EQUITY_PAIRS=false          # long strong / short weak NYSE pairs (opt-in)
# PAPER_SOCIAL_SLEEVE_ENABLED=false
# PAPER_MACRO_REGIME_ADAPTOR_ENABLED=true   # Best Paper Bot default (regime shift detector)
# PAPER_VOL_TRADING_ENABLED=true      # VIX overlay: short VXX calm / protection stress (paper only)
# VOL_SLEEVE_CAP_PCT=0.08             # 5-10% of equity
# VOL_VIX_HIGH_THRESHOLD=20
# VOL_VIX_CALM_THRESHOLD=15
# PAPER_OPTIONS_SLEEVE_ENABLED=true   # covered calls on VTI/SPY (paper aggressive only)
# OPTIONS_SLEEVE_CAP_PCT=0.12         # 10-15% of equity
# OPTIONS_OTM_PCT=0.075               # 5-10% OTM strike
# OPTIONS_VIX_CALM_MAX=22             # sell calls only when VIX below this
# MACRO_OIL_SURGE_PCT=0.08
# MACRO_SAFE_HAVEN_CAP_PCT=0.12
# SOCIAL_MACRO_OVERRIDES_ENABLED=true
# SOCIAL_MACRO_BEAR_OVERRIDE_SCORE=-0.4
# SOCIAL_MACRO_BULL_OVERRIDE_SCORE=0.5
# PAPER_SOCIAL_SLEEVE_CAP_PCT=0.20
# PAPER_ACTIVE_SLEEVE_BOOST=1.40
# PAPER_CRYPTO_VOL_ONLY=false
# PAPER_WISDOM_SIZING_FLOOR=1.0
# PAPER_VTI_REBALANCE_DRIFT_PCT=0.01
# PAPER_CHASE_EXTRA=true          # enables beta scaling, Felix sync; overlap/chunk/cofire via PAPER_* defaults
# PAPER_CHASE_CYCLE_SEC=45
# PAPER_CHASE_CRYPTO_CYCLE_SEC=180
# PAPER_CHASE_REFRESH_SEC=600
# SOCIAL_SLEEVE_ENABLED=false     # opt-in; off by default even with PAPER_CHASE_EXTRA
# SOCIAL_SLEEVE_CAP_PCT=0.10
# SOCIAL_MIRROR_TO_LIVE_PCT=0.0   # keep 0 on paper-only research book

# Isolated ~$98k research book (optional):
# PAPER_APCA_API_KEY_ID=
# PAPER_APCA_API_SECRET_KEY=
# PAPER_CHASE_USE_RESEARCH_KEYS=yes

# Isolated crypto vol mean-reversion sleeve (run_paper_bot parent process; paper-only)
CRYPTO_VOL_SLEEVE_ENABLED=false
# CRYPTO_VOL_CYCLE_SEC=180

# Felix / creator sentiment (auto-on with PAPER_CHASE_EXTRA; optional manual):
# FELIX_SYNC_ENABLED=true
# FELIX_SENTIMENT_ENABLED=true
# FELIX_SYNC_INTERVAL_HOURS=24
# ANDREI_JIKH_YOUTUBE_ENABLED=true

# --- SpaceX IPO monitors (optional) ---
# SPACEX_IPO_MONITOR_ENABLED=true
# SPACEX_IPO_CRYPTO_OVERRIDE=true
# SPACEX_IPO_LISTING_MONITOR_ENABLED=true
# SPACEX_IPO_EXPECTED_DATE=2026-06-12
# SPACEX_IPO_AUTO_BUY=false
# KRAKEN_SPCX_BUY_ENABLED=false

# --- Kraken live (run_all.py autopilot mirrors paper Alpaca signals) ---
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=
# KRAKEN_API_SECRET=
# ALLOW_KRAKEN_TRADING=yes
# KRAKEN_AUTOPILOT_ENABLED=true
# KRAKEN_DRY_RUN=false
# KRAKEN_MAX_ORDER_USD=25
# KRAKEN_CYCLE_BUDGET_USD=50

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=you@gmail.com

# --- Grok MCP (Cursor; scripts/mcp/install_grok_mcp.ps1) ---
# GROK_API_KEY=              # or XAI_API_KEY — from https://console.x.ai
# Use Auto model in Cursor; call Grok via MCP tools (not Grok as chat model).

# --- Ops / security (optional) ---
# PORTAL_INVITE_CODE=        # required for dashboard signup (fail-closed if unset)
# PORTAL_ALLOW_OPEN_REGISTRATION=true   # dev only — allows signup without invite
# DB_MATRIX_CACHE_SEC=120      # TTL cache for load_close_matrix() in run_all.py
# STAT_ARB_BOOK_FILE=stat_arb_open_book.json
# CLOUD_BOT_RESTART_SEC=30
# CLOUD_BOT_MAX_RESTARTS=20
