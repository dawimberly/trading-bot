#!/bin/sh
# prepare-commit-msg — prepend Today's commit subject to README "## Recent changes"
# and stage it so the Commit button includes the update.
#
# Skip: merge/squash, SKIP_README_HOOK=1, subject contains [skip-readme]

MSG_FILE=$1
SOURCE=${2:-}

case "$SOURCE" in
  merge|squash) exit 0 ;;
esac

if [ -n "$SKIP_README_HOOK" ]; then
  exit 0
fi

if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
if [ -z "$SUBJECT" ]; then
  exit 0
fi

case "$SUBJECT" in
  *"[skip-readme]"*|*"\[skip-readme\]"*) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel) || exit 0
README="$ROOT/README.md"
if [ ! -f "$README" ]; then
  exit 0
fi

DATE=$(date +%Y-%m-%d)
SHORT=$(printf '%s' "$SUBJECT" | cut -c1-140)
BULLET="- **${DATE}** — ${SHORT}"

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "prepare-commit-msg: python not found — README not updated" >&2
  exit 0
fi

"$PY" - "$README" "$BULLET" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

readme = Path(sys.argv[1])
bullet = sys.argv[2].rstrip() + "\n"
text = readme.read_text(encoding="utf-8")

marker = "## Recent changes\n"
max_bullets = 8

def trim_section(body: str) -> str:
    lines = body.splitlines(keepends=True)
    out: list[str] = []
    count = 0
    for line in lines:
        if line.startswith("- **"):
            count += 1
            if count > max_bullets:
                continue
        out.append(line)
    return "".join(out)

if marker in text:
    before, after = text.split(marker, 1)
    body = after.lstrip("\n")
    first = body.splitlines()[0] if body else ""
    if first.strip() == bullet.strip():
        sys.exit(0)
    new_body = trim_section(bullet + body)
    text = before + marker + "\n" + new_body
    if not text.endswith("\n"):
        text += "\n"
else:
    lines = text.splitlines(keepends=True)
    insert_at = 0
    for i, line in enumerate(lines):
        if line.startswith("## "):
            insert_at = i
            break
    else:
        insert_at = min(len(lines), 12)
    block = marker + "\n" + bullet + "\n"
    text = "".join(lines[:insert_at]) + block + "".join(lines[insert_at:])

readme.write_text(text, encoding="utf-8", newline="\n")
PY

git add -- "$README" || true
exit 0
